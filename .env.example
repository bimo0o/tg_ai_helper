# Скопируйте в .env для локального запуска или воспользуйтесь start-скриптом.
# Для облака deploy-скрипт создаёт отдельный .env.cloud.
# Никогда не публикуйте настоящий токен или пароль в Git.

# Токен бота от @BotFather (обязательно).
BOT_TOKEN=
# Локально можно оставить пустым; в облаке прокси обязателен.
# Примеры: http://user:password@proxy.example:3128 или socks5://proxy.example:1080
# Символы @, :, / в логине/пароле кодируйте как %40, %3A, %2F.
TELEGRAM_PROXY_URL=

# Локально: 127.0.0.1 и опубликованный порт. В облаке: db и 5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=bot
POSTGRES_USER=bot
# Скрипт сгенерирует пароль, если поле пустое. После создания БД не меняйте его
# только в env-файле: пароль роли PostgreSQL хранится внутри самой БД.
POSTGRES_PASSWORD=

LOG_LEVEL=INFO
# Служебный HTTP-порт на 127.0.0.1; наружу в облаке не публикуется.
HEALTH_PORT=8080

# OpenRouter: замените ключ локально; здесь только вымышленное значение.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=example-not-a-real-api-key
LLM_MODEL=deepseek/deepseek-v3.2
# Необязательно: отдельный management key только для общего баланса /admin.
OPENROUTER_MANAGEMENT_KEY=
LLM_TIMEOUT_SECONDS=30
HISTORY_MAX_MESSAGES=40
HISTORY_MAX_CHARS=8000
# Разрешить явную команду /search в /music (обычный текст поиск не запускает).
MUSIC_WEB_SEARCH=true
DAILY_BUDGET_USD=2
USER_DAILY_BUDGET_USD=0.20
# При неизвестной стоимости резерв сохраняется до конца суток UTC.
REQUEST_RESERVE_USD=0.05
MAX_OUTPUT_TOKENS=1500
USER_REQUESTS_PER_MINUTE=3
USER_REQUESTS_PER_DAY=50
HISTORY_RETENTION_DAYS=30
STATISTICS_RETENTION_DAYS=90
MUSIC_PROFILE_RETENTION_DAYS=180
